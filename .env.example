# GEMINI_API_KEY: Optional for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSCODE: Optional server-side override passcode for Super Administrator login.
# When unset, use the first-run Super Admin setup form in the UI to claim the admin password.
ADMIN_PASSCODE=

# SMTP Email Configuration (for Forgot Password email verification)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
